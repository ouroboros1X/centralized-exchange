generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String     @id @default(uuid())
  username     String     @unique
  email        String     @unique


  passwordHash String


  status       UserStatus @default(ACTIVE)

  createdAt    DateTime   @default(now())


  updatedAt    DateTime   @updatedAt


  orders       Order[]

  account      Account?
}


enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  PENDING
}

model Account {
  id        String   @id @default(uuid())

  userId    String   @unique

  user      User     @relation(
    fields: [userId],
    references: [id]
  )

  status    AccountStatus @default(ACTIVE)

  balances  Balance[]

  orders    Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}


model Asset {
  id        String      @id @default(uuid())

  symbol    String      @unique
  name      String


  type      AssetType

  decimals  Int

  status    AssetStatus  @default(ACTIVE)

  balances      Balance[]

  baseMarkets   Market[] @relation("BaseAsset")
  quoteMarkets  Market[] @relation("QuoteAsset")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}


enum AssetType {
  CRYPTO
  STABLECOIN
  FIAT
}


enum AssetStatus {
  ACTIVE
  SUSPENDED
  DEPRECATED
}


model Market {
  id           String       @id @default(uuid())

  symbol       String       @unique



  baseAssetId  String

  baseAsset    Asset @relation(
    "BaseAsset",
    fields: [baseAssetId],
    references: [id]
  )


  quoteAssetId String

  quoteAsset   Asset @relation(
    "QuoteAsset",
    fields: [quoteAssetId],
    references: [id]
  )

  status       MarketStatus @default(ACTIVE)

  orders       Order[]
  trades       Trade[]

  config       MarketConfig?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


enum MarketStatus {
  ACTIVE
  SUSPENDED
  DEPRECATED
}


model MarketConfig {
  id                String   @id @default(uuid())

  marketId          String   @unique

  market            Market   @relation(
    fields: [marketId],
    references: [id]
  )

  minOrderQuantity  Decimal
  maxOrderQuantity  Decimal
  minNotional       Decimal

  pricePrecision    Int
  quantityPrecision Int

  makerFeeRate      Decimal
  takerFeeRate      Decimal

  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}


model Order {
  id             String   @id @default(uuid())

  userId         String

  user           User     @relation(
    fields: [userId],
    references: [id]
  )

  accountId      String

  account        Account  @relation(
    fields: [accountId],
    references: [id]
  )

  marketId       String

  market         Market   @relation(
    fields: [marketId],
    references: [id]
  )



  type           OrderType

  side           OrderSide

  price          Decimal?

  quantity       Decimal

  filledQuantity Decimal @default(0)


  status         OrderStatus @default(PENDING)

  timeInForce    OrderTimeInForce @default(GTC)

  fills          Fill[]


  makerTrades    Trade[] @relation("MakerOrder")
  takerTrades    Trade[] @relation("TakerOrder")


  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  cancelledAt    DateTime?
}


enum OrderType {
  LIMIT
  MARKET
  STOP_MARKET
  STOP_LIMIT
}


enum OrderSide {
  BUY
  SELL
}


enum OrderStatus {
  PENDING
  OPEN
  PARTIALLY_FILLED
  FILLED
  CANCELLED
  REJECTED
}


enum OrderTimeInForce {
  GTC
  IOC
  FOK
}

model Balance {
  id          String   @id @default(uuid())

  accountId   String

  account     Account  @relation(
    fields: [accountId],
    references: [id]
  )


  assetId     String

  asset       Asset    @relation(
    fields: [assetId],
    references: [id]
  )

  available  Decimal @default(0)
  locked     Decimal @default(0)


  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([accountId, assetId])
}


model Trade {
  id             String   @id @default(uuid())


  marketId       String

  market         Market   @relation(
    fields: [marketId],
    references: [id]
  )

  makerOrderId   String

  makerOrder     Order @relation(
    "MakerOrder",
    fields: [makerOrderId],
    references: [id]
  )


  takerOrderId   String

  takerOrder     Order @relation(
    "TakerOrder",
    fields: [takerOrderId],
    references: [id]
  )


  price          Decimal
  quantity       Decimal

  sequenceNumber Int

  fills          Fill[]

  createdAt      DateTime @default(now())
}


model Fill {
  id        String   @id @default(uuid())


  tradeId   String

  trade     Trade    @relation(
    fields: [tradeId],
    references: [id]
  )


  orderId   String

  order     Order    @relation(
    fields: [orderId],
    references: [id]
  )


  userId    String

  user      User     @relation(
    fields: [userId],
    references: [id]
  )


  quantity  Decimal
  price     Decimal

  role      FillRole

  createdAt DateTime @default(now())
}


enum FillRole {
  MAKER
  TAKER
}


model Ledger {
  id            String     @id @default(uuid())


  accountId     String

  account       Account    @relation(
    fields: [accountId],
    references: [id]
  )


  assetId       String

  asset         Asset      @relation(
    fields: [assetId],
    references: [id]
  )


  amount        Decimal

  type          LedgerType

  referenceId   String?

  balanceBefore Decimal
  balanceAfter  Decimal

  createdAt     DateTime   @default(now())

  metadata      Json?
}


enum LedgerType {
  DEPOSIT
  WITHDRAWAL
  TRADE
  FEE
  TRANSFER
  LOCK
  UNLOCK
}

model Deposit {
  id              String   @id @default(uuid())


  userId          String

  user            User     @relation(
    fields: [userId],
    references: [id]
  )


  accountId       String

  account         Account  @relation(
    fields: [accountId],
    references: [id]
  )


  assetId         String

  asset           Asset    @relation(
    fields: [assetId],
    references: [id]
  )


  amount          Decimal

  status          DepositStatus @default(PENDING)

  transactionHash String?


  createdAt       DateTime @default(now())

  confirmedAt     DateTime?

  metadata        Json?
}


enum DepositStatus {
  COMPLETED
  PENDING
  PROCESSING
}

model Withdrawal {
  id              String   @id @default(uuid())


  userId          String

  user            User     @relation(
    fields: [userId],
    references: [id]
  )


  accountId       String

  account         Account  @relation(
    fields: [accountId],
    references: [id]
  )


  assetId         String

  asset           Asset    @relation(
    fields: [assetId],
    references: [id]
  )


  amount          Decimal

  fee             Decimal @default(0)

  destination     String


  status          WithdrawalStatus @default(PENDING)


  transactionHash String?


  createdAt       DateTime @default(now())

  processedAt     DateTime?

  metadata        Json?
}


enum WithdrawalStatus {
  COMPLETED
  PENDING
  PROCESSING
}